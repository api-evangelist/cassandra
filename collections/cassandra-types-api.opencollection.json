{
  "opencollection": "1.0.0",
  "info": {
    "name": "Apache Cassandra REST API (via Stargate) Columns Types API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Cassandra-Token",
      "value": "{{X-Cassandra-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Types",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List user-defined types",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://{host}:8082/v2/schemas/keyspaces/:keyspace/types",
            "params": [
              {
                "name": "keyspace",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List user-defined types"
        },
        {
          "info": {
            "name": "Create a user-defined type",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://{host}:8082/v2/schemas/keyspaces/:keyspace/types",
            "params": [
              {
                "name": "keyspace",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a user-defined type"
        },
        {
          "info": {
            "name": "Delete a user-defined type",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "http://{host}:8082/v2/schemas/keyspaces/:keyspace/types/:type",
            "params": [
              {
                "name": "keyspace",
                "value": "",
                "type": "path"
              },
              {
                "name": "type",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a user-defined type"
        }
      ]
    }
  ],
  "bundled": true
}